# Copy to .env and replace every value. Use only A-Z a-z 0-9 . _ - (Anope's limit).
BETA_LINK_SECRET=change-me-beta-link
CYPHER_LINK_SECRET=change-me-cypher-link
SERVICES_SECRET=change-me-services-link
RPC_TOKEN=change-me-rpc-token
ALPHA_OPER_SECRET=change-me-alpha-oper
BETA_OPER_SECRET=change-me-beta-oper
CYPHER_OPER_SECRET=change-me-cypher-oper
# Optional: a nickname Anope makes Services Root once it is registered,
# identified and an IRC operator (/OPER). Leave empty for none.
SERVICES_ROOT=
